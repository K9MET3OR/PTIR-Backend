# ============================================================
# Environment variables required by PTIR02-BackEnd
# Copy this file to .env and fill in the values before running.
# NEVER commit a .env file with real secrets to version control.
# ============================================================


# ------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------

# Long, random string used for session signing and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
# REQUIRED in production — do not leave as the default 'dev-secret-key'.
SECRET_KEY=change-me-to-a-long-random-string


# ------------------------------------------------------------------
# JWT (Auth04)
# ------------------------------------------------------------------

# Secret used to sign JWTs. Should be DIFFERENT from SECRET_KEY so
# that rotating one does not invalidate the other.
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
# REQUIRED in production.
JWT_SECRET=change-me-to-another-long-random-string

# Lifetime of issued JWTs in hours. Defaults to 24.
JWT_EXPIRY_HOURS=24


# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------

# Hostname of the PostgreSQL server.
# Use 'db' when running via docker-compose; 'localhost' for local dev.
DB_HOST=db


# ------------------------------------------------------------------
# External APIs
# ------------------------------------------------------------------

# Base URL for the Portuguese postal-code lookup service.
# The endpoint called is: {POSTAL_CODE_API_URL}/{cp4}/{cp3}
# Expected JSON response shape: [{"Localidade": "LISBOA", ...}]
# Defaults to the CTT public endpoint if unset.
POSTAL_CODE_API_URL=https://www.cttcodigopostal.pt/api/getzipcode
